# Raspberry Pi's libcamera fork, needed for the RPi Camera on Ubuntu (see README, "RPi Camera").
# From ros2_ws/:  vcs import src < camera.repos
# Pinned: newer libcamera deprecates APIs that camera_ros 0.6.0 uses, and its build treats
# that as an error. Move both pins together, and test the camera build before committing.
repositories:
  libcamera:
    type: git
    url: https://github.com/raspberrypi/libcamera.git
    version: v0.7.0+rpt20260205
