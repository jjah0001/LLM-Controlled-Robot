# Third-party packages. From ros2_ws/:  vcs import src < robot.repos
# camera_ros is pinned to a release that builds against the libcamera in camera.repos.
repositories:
  D05_lidar:
    type: git
    url: https://github.com/jjah0001/D05_lidar.git
    version: main
  camera_ros:
    type: git
    url: https://github.com/christianrauch/camera_ros.git
    version: 0.6.0
